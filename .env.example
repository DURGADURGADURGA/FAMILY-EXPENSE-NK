# =========================================================
# Family Expense Manager Pro
# Environment Configuration
# =========================================================

# -------------------------
# APP
# -------------------------
APP_NAME=Family Expense Manager Pro
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False

# -------------------------
# STREAMLIT
# -------------------------
PAGE_TITLE=Family Expense Manager
PAGE_ICON=💰
LAYOUT=wide

# -------------------------
# FIREBASE WEB CONFIG
# -------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# -------------------------
# FIREBASE ADMIN
# -------------------------
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# -------------------------
# GEMINI AI
# -------------------------
GEMINI_API_KEY=

# -------------------------
# APP SETTINGS
# -------------------------
DEFAULT_LANGUAGE=English
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=India
DEFAULT_TIMEZONE=Asia/Kolkata

# -------------------------
# SECURITY
# -------------------------
SESSION_TIMEOUT=60
PASSWORD_MIN_LENGTH=8

# -------------------------
# FILE UPLOAD
# -------------------------
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png
ALLOWED_DOCUMENT_EXTENSIONS=pdf,xlsx,csv

# -------------------------
# EXPORT
# -------------------------
PDF_AUTHOR=Family Expense Manager
PDF_TITLE=Expense Report

# -------------------------
# OCR
# -------------------------
OCR_LANGUAGE=en

# -------------------------
# WHATSAPP
# -------------------------
WHATSAPP_ENABLED=True

# -------------------------
# EMAIL
# -------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
